# Supabase Configuration
# Obtain these from your Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key (Server-only, NEVER expose to the client)
# Used exclusively for admin bootstrapping and protected background sync
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Public App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Official Ticket Purchase Link
NEXT_PUBLIC_TICKET_URL=https://meeteor.me/clip/join?eventId=DSVXOF

# Resend Transactional Email Configuration (Server-only)
# Obtain from Resend Dashboard -> API Keys
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=VolTex <noreply@mail.nkaylabs.com>

# Administrator Transactional Alert Recipient(s)
# Comma-separated email addresses to receive new referral submission alerts
ADMIN_NOTIFICATION_EMAILS=admin@tedxgwarinpa.org
